      {
        "@language": "ko",
        "@value": "구술 증언을 직접 제공한 사람. 사건의 직접 경험자이거나 가족·공동체를 통해 역사적 사실을 전승한 당사자."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ko",
        "@value": "OralHistoryNarrator"
      },
