      }
    ]
  },
  {
    "@id": "https://yimjhkr68.github.io/oral-history-ontology/core#OralHistoryRecord",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "면담을 통해 수집된 구술 텍스트·음성·영상 등의 1차 기록물. 아카이브의 핵심 객체."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ko",
        "@value": "OralHistoryRecord"
      },
      {
        "@language": "ko",
        "@value": "구술 기록"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
