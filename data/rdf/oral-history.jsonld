    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "제주 4.3 역사적 시기가 개별 역사적 사건을 포함함. 초토화 작전의 구성 요소 포함 관계도 포괄"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://yimjhkr68.github.io/oral-history-ontology/core#HistoricalPeriod"
