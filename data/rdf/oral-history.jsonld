      {
        "@id": "http://www.cidoc-crm.org/cidoc-crm/E7_Activity"
      }
    ]
  },
  {
    "@id": "https://yimjhkr68.github.io/oral-history-ontology/core#TraumaticMemory",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "ko",
        "@value": "사건 당시의 극한 공포·상실 경험이 구술자의 기억 속에 각인된 심리적 상태. 아동기 트라우마 포함."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ko",
        "@value": "TraumaticMemory"
      },
