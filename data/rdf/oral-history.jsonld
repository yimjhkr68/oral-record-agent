      {
        "@language": "ko",
        "@value": "구술자의 직계 가족 또는 친척 중 4.3 사건으로 인해 희생된 인물. 기존 Victim 클래스의 하위 개념으로, 가족 관계가 명확히 서술된 경우."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "ko",
        "@value": "FamilyVictim"
      },
