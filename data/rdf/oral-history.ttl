ora:BirthEvent a owl:Class ;
    rdfs:label "BirthEvent"@ko,
        "출생 사건"@ko ;
    rdfs:comment "구술자 또는 관련 인물의 출생 사실. 역사적 사건과 동일한 날짜에 발생하여 특별한 의미를 갖는 경우를 포함."@ko ;
    rdfs:subClassOf crm:E5_Event,
        schema:Event ;
    owl:equivalentClass crm:E67_Birth .

ora:CommunityVictim a owl:Class ;
    rdfs:label "CommunityVictim"@ko,
        "마을 공동체 희생자"@ko ;
    rdfs:comment "구술자의 가족은 아니나 같은 마을·공동체에 속해 4.3 사건으로 희생된 이웃 인물. 공동체 전체의 피해를 증언하는 맥락에서 등장."@ko ;
    rdfs:subClassOf crm:E74_Group,
        schema:Person ;
    owl:equivalentClass crm:E21_Person .

ora:FamilyVictim a owl:Class ;
    rdfs:label "FamilyVictim"@ko,
        "가족 희생자"@ko ;
    rdfs:comment "구술자의 직계 가족 또는 친척 중 4.3 사건으로 인해 희생된 인물. 기존 Victim 클래스의 하위 개념으로, 가족 관계가 명확히 서술된 경우."@ko ;
    rdfs:subClassOf crm:E21_Person,
        crm:E69_Death,
        schema:Person ;
    owl:equivalentClass crm:E21_Person .

ora:ForcedDisplacement a owl:Class ;
    rdfs:label "ForcedDisplacement"@ko,
        "강제 피난 / 소개"@ko ;
    rdfs:comment "초토화 작전·마을 소각으로 인해 주민들이 거주지를 떠나 피난하거나 강제로 이주된 사건."@ko ;
    rdfs:subClassOf crm:E53_Place,
        crm:E5_Event,
        schema:Event ;
    owl:equivalentClass crm:E9_Move .

ora:MemorialEvent a owl:Class ;
    rdfs:label "MemorialEvent"@ko,
        "추모 행사/위령제"@ko ;
    rdfs:comment "4.3 희생자를 기리기 위해 정기적으로 거행되는 추모·위령 행사"@ko ;
    rdfs:subClassOf crm:E5_Event,
        schema:Event ;
    owl:equivalentClass crm:E7_Activity .

ora:OralRecord a owl:Class ;
