    rdfs:subClassOf crm:E21_Person,
        foaf:Person,
        schema:Person ;
    owl:equivalentClass crm:E21_Person .

ora:MilitaryForce a owl:Class ;
    rdfs:label "MilitaryForce"@ko,
        "군인/군경"@ko ;
    rdfs:comment "제주 4.3 사건 당시 주민 학살·진압 작전·초토화 작전을 수행한 군사 세력 또는 군인 집단"@ko ;
