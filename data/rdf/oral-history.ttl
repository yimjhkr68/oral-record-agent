ora:제주시_조천면_북촌리 a ora:Place .

ora:Interviewer a owl:Class ;
    rdfs:label "Interviewer"@ko,
        "면담자"@ko ;
    rdfs:comment "구술 면담을 진행하고 기록을 수집한 연구자 또는 아카이비스트."@ko ;
    rdfs:subClassOf dcterms:Agent,
        crm:E21_Person,
        schema:Person ;
    owl:equivalentClass crm:E21_Person .

ora:ScorchingOperation a owl:Class ;
    rdfs:label "ScorchingOperation"@ko,
        "초토화 작전"@ko ;
    rdfs:comment "제주 4.3 당시 군경이 마을을 소각하고 주민을 강제 이주시킨 군사 작전"@ko ;
    rdfs:subClassOf crm:E1_CRM_Entity,
        crm:E5_Event,
        schema:Event ;
    owl:equivalentClass crm:E7_Activity .

ora:Survivor a owl:Class ;
    rdfs:label "Survivor"@ko,
        "생존자·유족"@ko ;
    rdfs:comment "학살·탄압에서 살아남거나 희생자의 가족으로서 사건의 영향을 직접 받은 인물"@ko ;
    rdfs:subClassOf crm:E21_Person .

ora:Evacuation a owl:Class ;
    rdfs:label "Evacuation"@ko,
        "피난/대피"@ko ;
    rdfs:comment "방화 및 군사 작전으로 인해 주민이 집을 떠나 도피한 행위"@ko ;
    rdfs:subClassOf crm:E1_CRM_Entity .

ora:Trauma a owl:Class ;
    rdfs:label "Trauma"@ko,
        "트라우마·피해 경험"@ko ;
    rdfs:comment "학살·탄압 경험에서 비롯된 심리적 상처와 억압된 기억, 그리고 구술자가 직접 겪은 피해·공포·상실의 경험을 포괄"@ko ;
    rdfs:subClassOf crm:E28_Conceptual_Object .

ora:HistoricalMassacreEvent a owl:Class ;
    rdfs:label "HistoricalMassacreEvent"@ko,
        "집단 학살 사건"@ko ;
    rdfs:comment "특정 날짜·장소에서 군·경에 의해 다수의 민간인이 집단으로 살해된 역사적 사건."@ko ;
    rdfs:subClassOf crm:E4_Period,
        schema:Event ;
    owl:equivalentClass crm:E5_Event .

ora:InterviewSession a owl:Class ;
    rdfs:label "InterviewSession"@ko,
        "면담 세션"@ko ;
    rdfs:comment "구술 기록이 수집된 구체적인 면담 행위. 일시·장소·참여자 정보를 포함."@ko ;
    rdfs:subClassOf crm:E5_Event,
        schema:Event ;
    owl:equivalentClass crm:E7_Activity .

ora:HistoricalPeriod a owl:Class ;
    rdfs:label "HistoricalPeriod"@ko,
        "역사적 시기"@ko ;
    rdfs:comment "제주 4.3 사건이 발생한 역사적·정치적 시기. 1947~1954년 제주 4.3 전반의 맥락을 포함."@ko ;
    rdfs:subClassOf dcterms:PeriodOfTime,
        schema:Event ;
    owl:equivalentClass crm:E4_Period .

ora:FamilyMember a owl:Class ;
    rdfs:label "FamilyMember"@ko,
        "가족 구성원"@ko ;
    rdfs:comment "구술 증언에 등장하는 구술자의 가족. 피난·경험 과정에서 함께한 인물로 서사 내 중요 역할을 담당"@ko ;
    rdfs:subClassOf rico:Family .

ora:SurvivorFamily a owl:Class ;
    rdfs:label "SurvivorFamily"@ko,
        "유가족 / 생존 가족"@ko ;
    rdfs:comment "희생자의 가족으로서 사건 이후 생존하며 트라우마와 사회적 낙인을 감내한 인물."@ko ;
    rdfs:subClassOf crm:E74_Group,
        schema:Person ;
    owl:equivalentClass crm:E21_Person .

ora:Victim a owl:Class ;
    rdfs:label "Victim"@ko,
        "희생자"@ko ;
    rdfs:comment "제주 4.3 사건으로 인해 생명을 잃거나 직접적 피해를 당한 인물."@ko ;
    rdfs:subClassOf crm:E21_Person,
        crm:E69_Death,
        schema:Person ;
    owl:equivalentClass crm:E21_Person .

ora:HistoricalEvent a owl:Class ;
    rdfs:label "HistoricalEvent"@ko,
        "역사적 사건"@ko ;
    rdfs:comment "구술 증언에서 언급된 역사적 사건. 특정 일시·장소에서 발생한 학살·진압·방화·군사작전 등을 포함하며, 제주 4.3 관련 구체적 사건들을 망라함"@ko ;
    rdfs:subClassOf crm:E5_Event .

ora:OralHistoryRecord a owl:Class ;
    rdfs:label "OralHistoryRecord"@ko,
        "구술 기록"@ko ;
    rdfs:comment "면담을 통해 수집된 구술 텍스트·음성·영상 등의 1차 기록물. 아카이브의 핵심 객체."@ko ;
    rdfs:subClassOf crm:E31_Document,
        foaf:Document,
        schema:CreativeWork ;
    owl:equivalentClass crm:E33_Linguistic_Object .

ora:Place a owl:Class ;
    rdfs:label "Place"@ko,
        "장소"@ko ;
    rdfs:comment "사건·면담·활동이 발생하거나 연관된 지리적 장소."@ko ;
    rdfs:subClassOf dcterms:Location,
        crm:E53_Place,
        schema:Place ;
    owl:equivalentClass crm:E53_Place .

ora:OralHistoryNarrator a owl:Class ;
    rdfs:label "OralHistoryNarrator"@ko,
        "구술자"@ko ;
    rdfs:comment "구술 증언을 직접 제공한 사람. 사건의 직접 경험자이거나 가족·공동체를 통해 역사적 사실을 전승한 당사자."@ko ;
    rdfs:subClassOf foaf:Person,
        schema:Person ;
    owl:equivalentClass crm:E21_Person .

