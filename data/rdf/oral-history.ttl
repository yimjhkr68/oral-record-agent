ora:ArmedSuppressionUnit a owl:Class ;
    rdfs:label "ArmedSuppressionUnit"@ko,
        "토벌대"@ko ;
    rdfs:comment "4.3 사건 당시 마을 주민을 체포·학살한 토벌 부대. 기존 MilitaryUnit보다 구체적으로 '토벌대'로 명시된 행위 주체."@ko ;
    rdfs:subClassOf crm:E1_CRM_Entity,
        crm:E40_Legal_Body,
        schema:Organization ;
    owl:equivalentClass crm:E74_Group .

ora:EyewitnessTestimony a owl:Class ;
    rdfs:label "EyewitnessTestimony"@ko,
        "목격 증언"@ko ;
    rdfs:comment "구술자가 사건을 직접 목격한 경험을 바탕으로 서술한 구술 내용의 단위. 감각적·현장적 기억을 담은 1인칭 증언."@ko ;
    rdfs:subClassOf crm:E21_Person,
        foaf:Document,
        schema:CreativeWork ;
    owl:equivalentClass crm:E33_Linguistic_Object .

ora:GunfireSound a owl:Class ;
    rdfs:label "GunfireSound"@ko,
        "총소리 / 폭력의 청각적 기억"@ko ;
    rdfs:comment "4.3 사건 당시 또는 그 직후 주민들이 경험한 총소리 등 폭력 상황의 청각적 기억. 구술에서 역사적 사건의 생생한 증거로 기능하는 감각적 경험."@ko ;
    rdfs:subClassOf crm:E1_CRM_Entity,
        crm:E33_Linguistic_Object ;
    owl:equivalentClass crm:E5_Event .

ora:IdentityTransformation a owl:Class ;
    rdfs:label "IdentityTransformation"@ko,
        "정체성 변화 / 역사 인식 전환"@ko ;
    rdfs:comment "구술자가 4.3에 대한 수치·은폐에서 역사적 의미 부여와 자긍심으로 인식을 전환하는 내면적 과정. 생일과 역사적 사건의 날짜 일치를 부끄럼에서 특별함으로 재해석하는 경험 포함."@ko ;
    rdfs:subClassOf crm:E1_CRM_Entity,
        crm:E5_Event ;
    owl:equivalentClass crm:E7_Activity .

ora:MilitaryUnit a owl:Class ;
    rdfs:label "MilitaryUnit"@ko,
        "군·경 부대 / 무장 세력"@ko ;
    rdfs:comment "제주 4.3 사건 당시 마을에 진입하여 학살을 자행한 군인 또는 경찰 조직."@ko ;
    rdfs:subClassOf crm:E40_Legal_Body,
        schema:Organization ;
    owl:equivalentClass crm:E74_Group .

ora:TraumaticMemory a owl:Class ;
    rdfs:label "TraumaticMemory"@ko,
        "트라우마 기억"@ko ;
    rdfs:comment "사건 당시의 극한 공포·상실 경험이 구술자의 기억 속에 각인된 심리적 상태. 아동기 트라우마 포함."@ko ;
    rdfs:subClassOf crm:E28_Conceptual_Object,
        crm:E5_Event ;
    owl:equivalentClass crm:E55_Type .

ora:VillageBurning a owl:Class ;
    rdfs:label "VillageBurning"@ko,
        "마을 방화"@ko ;
    rdfs:comment "초토화 작전 중 군인들이 민가에 불을 지른 구체적 행위"@ko ;
    rdfs:subClassOf crm:E1_CRM_Entity,
        crm:E5_Event ;
    owl:equivalentClass crm:E7_Activity .

