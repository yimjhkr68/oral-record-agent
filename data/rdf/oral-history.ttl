ora:Archive a owl:Class ;
    rdfs:label "Archive"@ko,
        "아카이브 / 컬렉션"@ko ;
    rdfs:comment "구술 기록을 수집·보존·활용하는 아카이브 기관 또는 컬렉션 단위."@ko ;
    rdfs:subClassOf foaf:Organization,
        schema:ArchiveComponent ;
    owl:equivalentClass crm:E78_Curated_Holding .

ora:CommemorativeRitual a owl:Class ;
    rdfs:label "CommemorativeRitual"@ko,
        "추모 의례"@ko ;
    rdfs:comment "희생자를 기리기 위해 수행되는 제례·위령제 등의 의례 행위"@ko ;
    rdfs:subClassOf crm:E7_Activity .

ora:Death a owl:Class ;
    rdfs:label "Death"@ko,
        "사망·희생"@ko ;
    rdfs:comment "희생자가 총살 등 폭력 행위로 사망한 사건"@ko ;
    rdfs:subClassOf crm:E69_Death .

ora:InterviewActivity a owl:Class ;
    rdfs:label "InterviewActivity"@ko,
        "면담 활동"@ko ;
    rdfs:comment "면담자가 구술자를 대상으로 수행한 채록 면담 행위"@ko ;
    rdfs:subClassOf crm:E7_Activity .

ora:Narrator a owl:Class ;
    rdfs:label "Narrator"@ko,
        "구술자"@ko ;
    rdfs:comment "역사적 사건을 직접 경험하고 구술 증언을 제공한 인물"@ko ;
    rdfs:subClassOf foaf:Person,
        schema:Person,
        rico:Person ;
    owl:equivalentClass crm:E21_Person .

ora:SilenceCulture a owl:Class ;
    rdfs:label "SilenceCulture"@ko,
        "침묵/금기 문화"@ko ;
    rdfs:comment "4.3 사건에 대한 언급이 억압·금기시되어 공적·사적 담론에서 배제된 사회적 현상"@ko ;
    rdfs:subClassOf crm:E1_CRM_Entity,
        crm:E55_Type ;
    owl:equivalentClass crm:E4_Period .

ora:TimePeriod a owl:Class ;
    rdfs:label "TimePeriod"@ko,
        "시간/시기"@ko ;
    rdfs:comment "구술 내용과 관련된 특정 날짜, 시점 또는 역사적 시기"@ko ;
    rdfs:subClassOf dcterms:PeriodOfTime,
        crm:E4_Period,
        crm:E50_Date ;
    owl:equivalentClass crm:E52_Time-Span .

ora:TimeSpan a owl:Class ;
    rdfs:label "TimeSpan"@ko,
        "시간 범위·날짜"@ko ;
    rdfs:comment "사건 또는 면담과 관련된 특정 날짜·기간"@ko ;
    rdfs:subClassOf crm:E52_Time-Span .

ora:VillageDestruction a owl:Class ;
    rdfs:label "VillageDestruction"@ko,
        "마을 소각 / 파괴"@ko ;
    rdfs:comment "군·경에 의해 마을의 가옥·시설이 방화·파괴된 사건. 주민들의 삶의 기반이 물리적으로 소멸된 상태를 포함."@ko ;
    rdfs:subClassOf crm:E1_CRM_Entity,
        schema:Event ;
    owl:equivalentClass crm:E5_Event .

ora:ViolenceAct a owl:Class ;
    rdfs:label "ViolenceAct"@ko,
        "폭력 행위/희생"@ko ;
    rdfs:comment "4.3 사건 과정에서 발생한 학살, 연행, 사망 등 구체적인 폭력 행위 및 그 결과"@ko ;
    rdfs:subClassOf crm:E5_Event,
        crm:E7_Activity,
        schema:Event ;
    owl:equivalentClass crm:E69_Death .

ora:제주_4_3_사건 a ora:HistoricalPeriod ;
    dcterms:source "NAR-202603-0001_김순덕_구술기록.docx",
        "NAR-202603-0002_이판석_구술기록.docx" ;
