ora:CommemorativeAct a owl:Class ;
    rdfs:label "CommemorativeAct"@ko,
        "추모 / 제례 행위"@ko ;
    rdfs:comment "희생자를 기억하고 애도하기 위해 수행된 의례적·공식적 행위. 비밀 제사부터 국가 공인 위령제까지 포함."@ko ;
    rdfs:subClassOf crm:E5_Event,
        schema:Event ;
    owl:equivalentClass crm:E7_Activity .

ora:DeathEvent a owl:Class ;
    rdfs:label "DeathEvent"@ko,
        "사망 / 희생"@ko ;
    rdfs:comment "희생자 개인의 사망 사실. 날짜·방식·장소 등의 정보를 담음."@ko ;
    rdfs:subClassOf schema:Event ;
    owl:equivalentClass crm:E69_Death .

ora:HistoricalPerson a owl:Class ;
    rdfs:label "HistoricalPerson"@ko,
        "역사적 관련 인물"@ko ;
    rdfs:comment "구술 내용에 등장하는 구술자 외 인물(가족, 이웃 등)로 사건과 직·간접적으로 연관된 자"@ko ;
    rdfs:subClassOf dcterms:Agent,
        crm:E21_Person,
        schema:Person ;
    owl:equivalentClass crm:E21_Person .

ora:SocialStigma a owl:Class ;
    rdfs:label "SocialStigma"@ko,
        "사회적 낙인 / 연좌제 피해"@ko ;
    rdfs:comment "4.3 유가족이 '빨갱이 가족'으로 낙인찍혀 받은 사회적 차별·억압·침묵 강요 등의 피해 상황."@ko ;
    rdfs:subClassOf crm:E55_Type ;
    owl:equivalentClass crm:E5_Event .

ora:StateRecognition a owl:Class ;
    rdfs:label "StateRecognition"@ko,
        "국가 공인 / 명예 회복"@ko ;
    rdfs:comment "국가가 4.3 사건 희생자와 유가족의 피해를 공식 인정하고 명예를 회복시키는 행정·법적 행위."@ko ;
    rdfs:subClassOf crm:E40_Legal_Body,
        schema:Event ;
    owl:equivalentClass crm:E7_Activity .

ora:북촌리_대학살 a ora:HistoricalEvent ;
