@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ora: <https://yimjhkr68.github.io/oral-history-ontology/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rico: <https://www.ica.org/standards/RiC/ontology#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://yimjhkr68.github.io/oral-history-ontology/core> a owl:Ontology ;
    rdfs:label "한국 구술기록 온톨로지"@ko ;
    dcterms:created "2026-04-13"^^xsd:date ;
    owl:versionInfo "1.0.0" .

ora:Dwelling a owl:Class ;
    rdfs:label "Dwelling"@ko,
        "가옥/주거지"@ko ;
    rdfs:comment "구술 증언에 등장하는 주민의 거주 건물, 특히 짚 지붕 전통 가옥"@ko ;
    rdfs:subClassOf crm:E1_CRM_Entity,
        crm:E53_Place,
        schema:Place ;
    owl:equivalentClass crm:E27_Site .

ora:HistoricalIncident a owl:Class ;
    rdfs:label "HistoricalIncident"@ko,
        "역사적 사건(제주 4.3)"@ko ;
    rdfs:comment "1948~1954년에 걸쳐 제주도에서 발생한 무장봉기 및 군경의 대규모 탄압·학살 사건 전체를 지칭하는 역사적 시기"@ko ;
    rdfs:subClassOf dcterms:PeriodOfTime,
        crm:E5_Event,
        schema:Event ;
    owl:equivalentClass crm:E4_Period .

ora:MassacreEvent a owl:Class ;
    rdfs:label "MassacreEvent"@ko,
        "학살 사건"@ko ;
    rdfs:comment "특정 일시·장소에서 군경에 의해 다수의 민간인이 집단 살해된 사건"@ko ;
    rdfs:subClassOf crm:E5_Event,
        schema:Event ;
    owl:equivalentClass crm:E5_Event .

ora:OralHistoryNarrative a owl:Class ;
    rdfs:label "OralHistoryNarrative"@ko,
        "구술 서사"@ko ;
    rdfs:comment "구술자가 직접 경험한 역사적 사건에 대해 증언한 구술 기록 텍스트"@ko ;
    rdfs:subClassOf crm:E1_CRM_Entity,
        foaf:Document,
        schema:CreativeWork ;
    owl:equivalentClass crm:E33_Linguistic_Object .

ora:PerpetratorGroup a owl:Class ;
    rdfs:label "PerpetratorGroup"@ko,
        "가해 집단(군경·토벌대)"@ko ;
    rdfs:comment "역사적 폭력 사건 당시 학살·진압·토벌 활동을 수행한 군·경 조직 또는 무장 집단"@ko ;
    rdfs:subClassOf crm:E74_Group .

ora:TraumaticExperience a owl:Class ;
    rdfs:label "TraumaticExperience"@ko,
        "피해 경험"@ko ;
    rdfs:comment "구술자가 직접 겪은 피해·공포·상실의 경험으로 구술에 명시된 내용"@ko ;
    rdfs:subClassOf crm:E5_Event,
        crm:E7_Activity ;
    owl:equivalentClass crm:E5_Event .

ora:Village a owl:Class ;
    rdfs:label "Village"@ko,
        "마을"@ko ;
    rdfs:comment "구술 증언에서 언급된 피해 마을 또는 거주 공동체"@ko ;
    rdfs:subClassOf dcterms:Location,
        crm:E1_CRM_Entity,
        schema:Place ;
    owl:equivalentClass crm:E53_Place .

ora:ViolentAct a owl:Class ;
    rdfs:label "ViolentAct"@ko,
        "폭력 행위·희생"@ko ;
    rdfs:comment "역사적 사건 과정에서 발생한 학살·연행·총살·사망 등 구체적인 폭력 행위 및 그 결과. 개인 단위의 희생(사망 포함)을 표현"@ko ;
    rdfs:subClassOf crm:E1_CRM_Entity .

ora:record_469a7ee6_11cc_4ec4_a022_2124c0166e73 a ora:OralRecord ;
    rdfs:label "NAR-202603-0002_이판석_구술기록"@ko ;
    dcterms:created "2026-04-13T06:05:01.739674Z" ;
    dcterms:description """제주 4.3 구술기록 아카이브
Jeju April 3rd Oral History Archive
어린 시절 피난과 굶주림
구술 내용
[1] 열 살이었어요, 그때. 어른들이 무서운 표정으로 뭔가를 얘기하는 건 알겠는데 뭔지는 몰랐어. 갑자기 어머니가 짐을 쌌고 우리는 밤에 산 쪽으로 올라갔어요.
[2] 한라산 중턱에서 몇 달을 지냈어요. 동굴이나 바위 그늘 아래서. 먹을 게 없어서 풀뿌리도 캐 먹고, 고사리도 삶아 먹었어. 겨울엔 정말 추웠어요.
[3] 아버지는 마을에 남아있다가 결국 잡혀갔어요. 나중에 들으니까 형무소에 갇혔다고 했는데, 한국전쟁 때 처형됐다고 해요. 연락도 없이, 그냥 그렇게.
[4] 산에서 내려오라는 명령이 떨어졌어. 내려오면 살려준다고 했어. 어머니는 믿지 않았는데 더는 버틸 수가 없었어. 내려오니까 심문도 받고 힘든 일도 많았지만 살아남았어.
[5] 그 시절 얘기를 하면 지금도 가슴이 두근거려요. 무섭다기보다는... 억울해. 우리가 뭘 잘못했는지. 그냥 제주도에"""@ko .

ora:record_ee1f9376_a441_4415_a1f0_fd138109345d a ora:OralRecord ;
    rdfs:label "NAR-202603-0001_김순덕_구술기록"@ko ;
    dcterms:created "2026-04-13T06:05:01.693418Z" ;
    dcterms:description """제주 4.3 구술기록 아카이브
Jeju April 3rd Oral History Archive
북촌리 대학살의 기억
구술 내용
[1] 우리 아버지는 그때 마흔두 살이었어. 1949년 1월 17일, 그날을 어떻게 잊겠어. 북촌리에서 300명 넘게 죽었다고 하는데, 우리 아버지도 그날 총에 맞아 돌아가셨어.
[2] 군인들이 마을로 들어오면서 집집마다 남자들을 다 끌어냈어. 아버지는 아무것도 모른다고, 우리는 아무 잘못도 없다고 했지만 소용없었어. 총소리가 나고, 우린 숨어서 울기만 했어.
[3] 어머니는 그때부터 평생 혼자 우리 4남매를 키웠어. 아버지 얘기는 절대 못 하게 했어. 빨갱이 가족이라고 하면 우리도 살아남을 수가 없으니까.
[4] 제사도 몰래 지냈어. 4월 3일이 되면 어머니는 방문을 걸어 잠그고 혼자 울었어. 우리는 그게 왜인지 알면서도 모른 척해야 했어.
[5] 지금은 위령제도 하고, 국가에서 인정도 해줬다고 하는데, 그게 뭔 소용이야. 아버지는 돌아오지 않는데. 그래도"""@ko .

ora:record_f4ae0213_d68f_4c3c_85bd_cda3a24944f0 a ora:OralRecord ;
    rdfs:label "NAR-202603-0005_강옥희_구술기록"@ko ;
    dcterms:created "2026-04-13T04:02:45.169345Z" ;
    dcterms:description """제주 4.3 구술기록 아카이브
Jeju April 3rd Oral History Archive
여덟 살에 겪은 초토화 작전


구술 내용
[1] 우리 마을이 불탄 게 1948년 11월이었어요. 여덟 살이었는데, 군인들이 와서 집에 불을 질렀어. 짚으로 된 지붕이라 금방 타올랐어요.
[2] 어머니가 우리 손을 잡고 뛰어나왔어. 아무것도 못 챙겼어. 그냥 살기 위해서 도망쳤어요. 뒤를 돌아보니까 집이 시뻘겋게 타고 있었어.
[3] 마을 사람들이 다 들판으로 나왔어. 어떤 집은 식구가 다 나왔는데 어떤 집은 어른 남자가 없었어. 잡혀간 거야. 죽임을 당한 거야.
[4] 한겨울에 갈 곳이 없었어. 친척집을 전전하다가 결국 서귀포 읍내 천막촌에서 살았어. 먹을 게 없어서 구호품으로 연명했어요.
[5] 그때 입은 상처가 평생 갔어요. 나는 다행히 가족이 다 살아남았지만, 친구들 중에는 아버지나 오빠를 잃은 애들이 많았어요. 그 눈빛이 아직도 기억나.

면담 소견
본 구술 기록은 강옥희 구술자와"""@ko .

ora:가족_관계이다 a owl:ObjectProperty ;
    rdfs:label "가족 관계이다"@ko ;
    rdfs:comment "구술자·생존자·가족 구성원이 희생자 또는 다른 가족과 가족 관계에 있음"@ko ;
    rdfs:domain ora:FamilyMember,
        ora:OralHistoryNarrator,
        ora:Survivor ;
    rdfs:range ora:FamilyMember,
        ora:Survivor,
        ora:Victim ;
    owl:equivalentProperty crm:P1_is_identified_by .

